# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env files — never commit secrets (Supabase service role key, Gemini API key, etc.)
.env
.env.*
!.env.example

# Claude Code local-only settings (project skills under .claude/skills/ are intentionally committed)
.claude/settings.local.json
.claude/.DS_Store

# Supabase CLI
supabase/.branches/
supabase/.temp/
supabase/.env

# typescript
*.tsbuildinfo

# Playwright test artefacts (screenshots, videos, reports)
test-results/
playwright-report/
.playwright/

app-example

# generated native folders
/ios
/android
