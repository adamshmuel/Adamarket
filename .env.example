# Copy this to .env (which is gitignored) and fill in your own values.
# Both keys are PUBLIC for the client app — the anon key is designed to be exposed
# and is RLS-gated. Never put the Supabase SERVICE_ROLE key here or in the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=ey...

# Secrets (Gemini API key, Supabase service role key) live as Supabase Edge
# Function secrets, set via the CLI:
#   supabase secrets set GEMINI_API_KEY=...
